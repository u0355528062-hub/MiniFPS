/* ==========================================================================
   Blouse Blanche — feuille de style de l'interface (UI Toolkit)
   Thème sombre "bloc opératoire" : bleu nuit, verre dépoli, accent menthe.
   ========================================================================== */

.bb-root {
    --bg: #0B1220;
    --panel: rgba(12, 19, 33, 0.90);
    --panel-2: rgba(20, 30, 50, 0.94);
    --panel-3: rgba(30, 44, 68, 0.96);
    --glass: rgba(10, 16, 28, 0.62);
    --stroke: rgba(255, 255, 255, 0.07);
    --stroke-2: rgba(255, 255, 255, 0.14);
    --text: #EAF0F7;
    --dim: #A5B2C5;
    --muted: #6E7D93;
    --accent: #2FD4C0;
    --accent-dark: #0B3B36;
    --accent-2: #5B9BFF;
    --danger: #FF5A6A;
    --warning: #FFB547;
    --success: #3DDC97;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--text);
}

/* ---------------------------------------------------------------- polices */
.bb-root .unity-text-element { -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-Regular.ttf"); color: var(--text); font-size: 16px; white-space: normal; }
.bb-root .unity-text-element.w500 { -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-Medium.ttf"); }
.bb-root .unity-text-element.w600 { -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-SemiBold.ttf"); }
.bb-root .unity-text-element.w700 { -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-Bold.ttf"); }
.bb-root .unity-text-element.w800 { -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-ExtraBold.ttf"); }
.bb-root .unity-text-element.mono { -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/JetBrainsMono-Medium.ttf"); }
.bb-root .unity-text-element.mono-b { -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/JetBrainsMono-Bold.ttf"); }

.bb-root .t-display { font-size: 76px; letter-spacing: 2px; }
.bb-root .t-h1 { font-size: 42px; }
.bb-root .t-h2 { font-size: 28px; }
.bb-root .t-h3 { font-size: 20px; }
.bb-root .t-body { font-size: 17px; color: var(--dim); }
.bb-root .t-small { font-size: 14px; color: var(--dim); }
.bb-root .t-tiny { font-size: 12px; color: var(--muted); }
.bb-root .t-caption { font-size: 13px; letter-spacing: 2.4px; color: var(--accent); }
.bb-root .t-accent { color: var(--accent); }
.bb-root .t-danger { color: var(--danger); }
.bb-root .t-warning { color: var(--warning); }
.bb-root .t-success { color: var(--success); }
.bb-root .t-dim { color: var(--dim); }
.bb-root .t-muted { color: var(--muted); }
.bb-root .t-center { -unity-text-align: middle-center; }
.bb-root .t-right { -unity-text-align: middle-right; }

/* ---------------------------------------------------------------- calques */
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hidden { display: none; }

.fade { background-color: rgb(4, 7, 12); opacity: 0; transition-property: opacity; transition-duration: 0.45s; }
.fade.on { opacity: 1; }

.screen { opacity: 0; transition-property: opacity, translate; transition-duration: 0.35s; transition-timing-function: ease-out-cubic; translate: 0 14px; }
.screen.visible { opacity: 1; translate: 0 0; }

.scrim { background-color: rgba(4, 8, 14, 0.55); }
.scrim-strong { background-color: rgba(4, 8, 14, 0.82); }

/* ---------------------------------------------------------------- panneaux */
.panel {
    background-color: var(--panel);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--stroke-2);
    padding: 24px;
}
.panel-2 { background-color: var(--panel-2); border-radius: 14px; border-width: 1px; border-color: var(--stroke); padding: 16px; }
.card { background-color: rgba(255, 255, 255, 0.04); border-radius: 12px; border-width: 1px; border-color: var(--stroke); padding: 14px 16px; }
.divider { height: 1px; background-color: var(--stroke-2); margin: 14px 0; }
.row { flex-direction: row; align-items: center; }
.col { flex-direction: column; }
.grow { flex-grow: 1; }
.spacer { flex-grow: 1; }
.gap-s > * { margin-right: 8px; }
.gap-m > * { margin-right: 14px; }

/* ---------------------------------------------------------------- boutons */
.bb-root .bb-btn {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: var(--stroke-2);
    border-radius: 10px;
    padding: 11px 18px;
    margin: 0;
    font-size: 16px;
    color: var(--text);
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-SemiBold.ttf");
    transition-property: background-color, border-color, scale, color;
    transition-duration: 0.14s;
}
.bb-root .bb-btn:hover { background-color: rgba(255, 255, 255, 0.12); border-color: rgba(255, 255, 255, 0.30); }
.bb-root .bb-btn:active { scale: 0.97 0.97; }
.bb-root .bb-btn:focus { border-color: var(--accent); }
.bb-root .bb-btn:disabled { opacity: 0.35; }
.bb-root .bb-btn.primary { background-color: var(--accent); border-color: var(--accent); color: #052421; }
.bb-root .bb-btn.primary:hover { background-color: #4FE6D3; border-color: #4FE6D3; }
.bb-root .bb-btn.danger { background-color: var(--danger); border-color: var(--danger); color: #2A0509; }
.bb-root .bb-btn.danger:hover { background-color: #FF7684; }
.bb-root .bb-btn.ghost { background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); color: var(--dim); }
.bb-root .bb-btn.ghost:hover { color: var(--text); background-color: rgba(255, 255, 255, 0.06); }
.bb-root .bb-btn.small { padding: 7px 12px; font-size: 14px; border-radius: 8px; }
.bb-root .bb-btn.big { padding: 15px 26px; font-size: 18px; border-radius: 12px; }
.bb-root .bb-btn.selected { background-color: rgba(47, 212, 192, 0.16); border-color: var(--accent); color: var(--accent); }

/* Éléments de liste cliquables (questions, examens, diagnostics…) */
.bb-root .list-btn {
    background-color: rgba(255, 255, 255, 0.035);
    border-width: 1px;
    border-color: var(--stroke);
    border-radius: 10px;
    padding: 10px 14px;
    margin: 0 0 6px 0;
    font-size: 15px;
    color: var(--text);
    -unity-text-align: middle-left;
    -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-Medium.ttf");
    transition-property: background-color, border-color, translate;
    transition-duration: 0.12s;
}
.bb-root .list-btn:hover { background-color: rgba(255, 255, 255, 0.09); border-color: rgba(255, 255, 255, 0.22); translate: 3px 0; }
.bb-root .list-btn:disabled { opacity: 0.4; }
.bb-root .list-btn.done { color: var(--muted); background-color: rgba(255, 255, 255, 0.015); }
.bb-root .list-btn.selected { background-color: rgba(47, 212, 192, 0.15); border-color: var(--accent); color: #D7FFF9; }
.bb-root .list-btn.harm { border-color: rgba(255, 90, 106, 0.0); }

/* Menu principal */
.bb-root .menu-item {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    padding: 12px 18px;
    margin: 2px 0;
    font-size: 24px;
    color: var(--dim);
    -unity-text-align: middle-left;
    -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-SemiBold.ttf");
    transition-property: color, border-color, translate, background-color;
    transition-duration: 0.16s;
}
.bb-root .menu-item:hover { color: var(--text); border-left-color: var(--accent); translate: 8px 0; background-color: rgba(47, 212, 192, 0.06); }
.bb-root .menu-item:disabled { opacity: 0.35; }
.bb-root .menu-item.selected { color: var(--accent); border-left-color: var(--accent); background-color: rgba(47, 212, 192, 0.08); }

/* ---------------------------------------------------------------- puces */
.chip { padding: 4px 10px; border-radius: 999px; font-size: 12px; background-color: rgba(255, 255, 255, 0.08); color: var(--dim); -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-SemiBold.ttf"); }
.bb-root .unity-text-element.chip { -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-SemiBold.ttf"); font-size: 12px; }
.chip.ok { background-color: rgba(61, 220, 151, 0.16); color: var(--success); }
.chip.warn { background-color: rgba(255, 181, 71, 0.16); color: var(--warning); }
.chip.bad { background-color: rgba(255, 90, 106, 0.18); color: var(--danger); }
.chip.info { background-color: rgba(91, 155, 255, 0.16); color: var(--accent-2); }
.chip.accent { background-color: rgba(47, 212, 192, 0.16); color: var(--accent); }
.chip.solid-bad { background-color: var(--danger); color: #2A0509; }

.keycap {
    min-width: 34px;
    height: 34px;
    padding: 0 9px;
    border-radius: 8px;
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(255, 255, 255, 0.10);
    -unity-text-align: middle-center;
    font-size: 15px;
}
.bb-root .unity-text-element.keycap { -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/JetBrainsMono-Bold.ttf"); font-size: 15px; }

/* ---------------------------------------------------------------- HUD */
.hud-clock { position: absolute; left: 36px; top: 30px; padding: 14px 20px; border-radius: 16px; background-color: var(--glass); border-width: 1px; border-color: var(--stroke-2); }
.hud-next { position: absolute; right: 36px; top: 30px; width: 360px; padding: 14px 18px; border-radius: 16px; background-color: var(--glass); border-width: 1px; border-color: var(--stroke-2); }
.hud-objectives { position: absolute; left: 36px; top: 160px; width: 360px; padding: 12px 16px; border-radius: 14px; background-color: rgba(10, 16, 28, 0.45); }
.hud-hints { position: absolute; left: 36px; bottom: 30px; flex-direction: row; }
.crosshair { position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; margin-left: -3px; margin-top: -3px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.85); border-width: 1px; border-color: rgba(0, 0, 0, 0.45); transition-property: scale, background-color; transition-duration: 0.12s; }
.crosshair.target { scale: 1.8 1.8; background-color: var(--accent); }
.prompt { position: absolute; left: 0; right: 0; bottom: 120px; align-items: center; opacity: 0; transition-property: opacity, translate; transition-duration: 0.16s; translate: 0 8px; }
.prompt.visible { opacity: 1; translate: 0 0; }
.prompt-box { flex-direction: row; align-items: center; padding: 10px 18px 10px 10px; border-radius: 14px; background-color: var(--glass); border-width: 1px; border-color: var(--stroke-2); }
.prompt-box.disabled { opacity: 0.6; }

.subtitle { position: absolute; left: 0; right: 0; bottom: 190px; align-items: center; opacity: 0; transition-property: opacity; transition-duration: 0.3s; }
.subtitle.visible { opacity: 1; }
.bb-root.in-care .subtitle { bottom: 300px; }
.subtitle-box { max-width: 1000px; padding: 12px 22px; border-radius: 12px; background-color: rgba(6, 10, 18, 0.72); }

/* ---------------------------------------------------------------- notifications */
.toasts { position: absolute; right: 36px; top: 170px; width: 380px; }
.bb-root.in-care .toasts { top: 236px; right: 640px; }
.toast { flex-direction: row; margin-bottom: 10px; border-radius: 14px; background-color: var(--panel-2); border-width: 1px; border-color: var(--stroke-2); overflow: hidden; opacity: 0; translate: 40px 0; transition-property: opacity, translate; transition-duration: 0.3s; transition-timing-function: ease-out-back; }
.toast.visible { opacity: 1; translate: 0 0; }
.toast-bar { width: 5px; background-color: var(--accent-2); }
.toast.warning .toast-bar { background-color: var(--warning); }
.toast.urgent .toast-bar { background-color: var(--danger); }
.toast.success .toast-bar { background-color: var(--success); }
.toast.urgent { border-color: rgba(255, 90, 106, 0.6); background-color: rgba(48, 14, 22, 0.95); }
.toast-body { padding: 12px 16px; flex-grow: 1; flex-shrink: 1; }

/* ---------------------------------------------------------------- barres et jauges */
.bar { height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.08); overflow: hidden; }
.bar-fill { height: 100%; border-radius: 4px; background-color: var(--accent); transition-property: width; transition-duration: 0.8s; transition-timing-function: ease-out-cubic; }
.bar-fill.warn { background-color: var(--warning); }
.bar-fill.bad { background-color: var(--danger); }

.slider { height: 28px; justify-content: center; }
.slider-track { height: 6px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.12); }
.slider-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 3px; background-color: var(--accent); }
.slider-knob { position: absolute; top: 50%; width: 20px; height: 20px; margin-top: -10px; margin-left: -10px; border-radius: 10px; background-color: #FFFFFF; border-width: 3px; border-color: var(--accent); }

.toggle { width: 48px; height: 26px; border-radius: 13px; background-color: rgba(255, 255, 255, 0.14); transition-property: background-color; transition-duration: 0.15s; }
.toggle.on { background-color: var(--accent); }
.toggle-knob { position: absolute; left: 3px; top: 3px; width: 20px; height: 20px; border-radius: 10px; background-color: #FFFFFF; transition-property: translate; transition-duration: 0.15s; }
.toggle.on .toggle-knob { translate: 22px 0; }

.segmented { flex-direction: row; border-radius: 10px; background-color: rgba(255, 255, 255, 0.06); padding: 3px; }
.bb-root .segment { flex-grow: 1; padding: 7px 10px; margin: 0; border-width: 0; border-radius: 8px; background-color: rgba(0, 0, 0, 0); color: var(--dim); font-size: 14px; -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-SemiBold.ttf"); }
.bb-root .segment:hover { color: var(--text); }
.bb-root .segment.on { background-color: var(--accent); color: #052421; }

/* ---------------------------------------------------------------- onglets */
.tabs { flex-direction: row; border-bottom-width: 1px; border-color: var(--stroke-2); margin-bottom: 12px; }
.bb-root .tab { background-color: rgba(0, 0, 0, 0); border-width: 0; border-bottom-width: 2px; border-color: rgba(0, 0, 0, 0); border-radius: 0; padding: 10px 14px; margin: 0; color: var(--muted); font-size: 15px; -unity-font-definition: url("/Assets/BlouseBlanche/Fonts/Inter-SemiBold.ttf"); }
.bb-root .tab:hover { color: var(--text); }
.bb-root .tab.on { color: var(--accent); border-bottom-color: var(--accent); }

/* ---------------------------------------------------------------- défilement */
.bb-root .unity-scroll-view { flex-grow: 1; }
.bb-root .unity-scroller--vertical { width: 8px; }
.bb-root .unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.bb-root .unity-scroller--vertical .unity-base-slider__dragger { background-color: rgba(255, 255, 255, 0.18); border-width: 0; border-radius: 4px; width: 6px; left: 1px; }
.bb-root .unity-scroller__low-button, .bb-root .unity-scroller__high-button { display: none; }

/* ---------------------------------------------------------------- consultation */
.vital { width: 31%; margin: 0 2% 8px 0; padding: 10px 12px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: var(--stroke); }
.vital.attention { border-color: rgba(255, 181, 71, 0.6); background-color: rgba(255, 181, 71, 0.08); }
.vital.critique { border-color: rgba(255, 90, 106, 0.7); background-color: rgba(255, 90, 106, 0.10); }
.finding { padding: 10px 12px; margin-bottom: 8px; border-radius: 10px; border-left-width: 3px; border-color: var(--success); background-color: rgba(255, 255, 255, 0.04); }
.finding.attention { border-color: var(--warning); background-color: rgba(255, 181, 71, 0.07); }
.finding.critique { border-color: var(--danger); background-color: rgba(255, 90, 106, 0.09); }
.dialog-line { margin-bottom: 8px; }
.avatar { width: 56px; height: 56px; border-radius: 28px; background-color: var(--accent-dark); border-width: 2px; border-color: var(--accent); align-items: center; justify-content: center; }

/* ---------------------------------------------------------------- intervention SAMU / urgences */
.scope-box { width: 388px; height: 242px; border-radius: 10px; overflow: hidden; background-color: rgb(3, 7, 10); border-width: 1px; border-color: rgba(70, 255, 120, 0.25); }
.result-banner { padding: 12px 18px; border-radius: 12px; background-color: rgba(10, 16, 28, 0.82); border-width: 1px; border-left-width: 3px; border-color: var(--stroke-2); border-left-color: var(--accent); white-space: normal; }

/* ---------------------------------------------------------------- roue d'outils */
.wheel-backdrop { background-color: rgba(4, 8, 14, 0.45); }
.wheel { position: absolute; left: 50%; top: 50%; width: 840px; height: 840px; margin-left: -420px; margin-top: -420px; border-radius: 420px; background-color: rgba(8, 14, 26, 0.80); border-width: 1px; border-color: var(--stroke-2); scale: 0.9 0.9; opacity: 0; transition-property: scale, opacity; transition-duration: 0.18s; transition-timing-function: ease-out-back; }
.wheel.visible { scale: 1 1; opacity: 1; }
.wheel-ring { position: absolute; left: 90px; top: 90px; right: 90px; bottom: 90px; border-radius: 330px; border-width: 2px; border-color: rgba(255, 255, 255, 0.08); }
.wheel-slot { position: absolute; width: 112px; height: 112px; margin-left: -56px; margin-top: -56px; border-radius: 56px; background-color: rgba(22, 32, 52, 0.95); border-width: 2px; border-color: rgba(255, 255, 255, 0.18); align-items: center; justify-content: center; transition-property: scale, background-color, border-color; transition-duration: 0.12s; }
.wheel-slot.hover { scale: 1.25 1.25; background-color: var(--accent); border-color: #B4FFF5; }
.wheel-slot.current { border-color: var(--accent); }
.wheel-icon { width: 64px; height: 64px; -unity-background-image-tint-color: #E1EBF5; }
.wheel-slot.hover .wheel-icon { -unity-background-image-tint-color: #0B1220; }
.wheel-key { position: absolute; right: -2px; top: -2px; width: 30px; height: 30px; border-radius: 15px; background-color: rgb(8, 14, 26); border-width: 1px; border-color: rgba(255, 255, 255, 0.3); -unity-text-align: middle-center; font-size: 14px; }
.wheel-center { position: absolute; left: 50%; top: 50%; width: 400px; height: 400px; margin-left: -200px; margin-top: -200px; border-radius: 200px; background-color: rgb(15, 24, 42); border-width: 2px; border-color: rgba(255, 255, 255, 0.12); align-items: center; justify-content: center; padding: 50px; }

/* ---------------------------------------------------------------- résultat */
.score-ring { width: 200px; height: 200px; border-radius: 100px; border-width: 10px; border-color: var(--accent); align-items: center; justify-content: center; background-color: rgba(47, 212, 192, 0.06); }
.score-ring.warn { border-color: var(--warning); background-color: rgba(255, 181, 71, 0.06); }
.score-ring.bad { border-color: var(--danger); background-color: rgba(255, 90, 106, 0.08); }
.feedback { flex-direction: row; margin-bottom: 8px; }
.dot { width: 10px; height: 10px; border-radius: 5px; margin: 6px 12px 0 0; background-color: var(--accent-2); flex-shrink: 0; }
.dot.good { background-color: var(--success); }
.dot.warn { background-color: var(--warning); }
.dot.bad { background-color: var(--danger); }
.dot.critical { background-color: var(--danger); border-width: 2px; border-color: #FFFFFF; }
.stat { flex-grow: 1; margin-right: 14px; padding: 18px; border-radius: 14px; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: var(--stroke); }

/* ---------------------------------------------------------------- menu */
.mode-card { width: 250px; height: 150px; margin-left: 14px; padding: 16px; border-radius: 16px; background-color: rgba(12, 19, 33, 0.82); border-width: 1px; border-color: var(--stroke-2); transition-property: translate, border-color, background-color; transition-duration: 0.16s; }
.mode-card:hover { translate: 0 -6px; border-color: rgba(255, 255, 255, 0.35); }
.mode-card.active { border-color: var(--accent); background-color: rgba(11, 59, 54, 0.85); }
.mode-card.locked { opacity: 0.7; }
.logo-mark { width: 64px; height: 64px; border-radius: 16px; background-color: var(--accent); align-items: center; justify-content: center; margin-right: 18px; }
.logo-cross-v { position: absolute; width: 14px; height: 40px; background-color: #052421; border-radius: 3px; }
.logo-cross-h { position: absolute; width: 40px; height: 14px; background-color: #052421; border-radius: 3px; }
.menu-gradient { position: absolute; left: 0; top: 0; bottom: 0; width: 760px; background-color: rgba(6, 10, 18, 0.72); }
.loading-bar { width: 520px; height: 6px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.10); overflow: hidden; }
.loading-fill { height: 100%; background-color: var(--accent); border-radius: 3px; transition-property: width; transition-duration: 0.25s; }

.loading-out { opacity: 0; transition-property: opacity; transition-duration: 0.8s; }

.modal { position: absolute; left: 50%; top: 50%; width: 560px; margin-left: -280px; margin-top: -150px; }
