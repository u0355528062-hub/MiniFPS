<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Vérification de compilation hors de Unity (CI, conteneur sans éditeur).
    Compile les scripts du projet contre les assemblies de référence de UnityEngine (NuGet)
    et de petits stubs des paquets URP / Input System (dossier Stubs).
    Usage : ./check.sh   (voir README à la racine du dépôt)
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>BlouseBlanche.CompileCheck</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Avertissements propres à la compilation hors Unity (champs sérialisés, versions d'assemblies). -->
    <NoWarn>$(NoWarn);CS0649;CS0414;CS1701;CS1702;CS1591;MSB3277;NU1701</NoWarn>
    <!-- Configurations : passées par check.sh -->
    <BBDefines Condition="'$(BBDefines)' == ''">ENABLE_INPUT_SYSTEM</BBDefines>
    <BBEditor Condition="'$(BBEditor)' == ''">false</BBEditor>
    <DefineConstants>UNITY_6000_0_OR_NEWER;UNITY_2021_3_OR_NEWER;UNITY_STANDALONE;$(BBDefines)</DefineConstants>
    <DefineConstants Condition="'$(BBEditor)' == 'true'">$(DefineConstants);UNITY_EDITOR</DefineConstants>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../'))</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Unity3D.SDK" Version="2021.1.14.1" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(PkgUnityEngine_Modules)/lib/net45/*.dll" Private="false" />
    <Reference Include="$(PkgUnity3D_SDK)/lib/UnityEditor.dll" Private="false" Condition="'$(BBEditor)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)Assets/**/*.cs" Exclude="$(RepoRoot)Assets/**/Editor/**/*.cs" />
    <Compile Include="$(RepoRoot)Assets/**/Editor/**/*.cs" Condition="'$(BBEditor)' == 'true'" />
    <Compile Include="Stubs/*.cs" />
    <Compile Include="Stubs/Editor/*.cs" Condition="'$(BBEditor)' == 'true'" />
  </ItemGroup>
</Project>
