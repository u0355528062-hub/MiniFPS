; BLOC URGENCES — simulateur de chirurgie à la première personne (Godot 4.7, PC).

config_version=5

[application]

config/name="Bloc Urgences"
config/description="Simulateur chirurgical à la première personne : pose d'un drain thoracique en urgence, anatomie réelle."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/custom_font="res://assets/fonts/Inter.ttf"

[physics]

common/physics_ticks_per_second=120

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.07, 1)
reflections/sky_reflections/roughness_layers=7
textures/default_filters/anisotropic_filtering_level=4
