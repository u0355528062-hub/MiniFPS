static func par_id(id: String) -> Dictionary:
	for p in LISTE:
		if p["id"] == id:
			return p
	return {}


## Liste des diagnostics proposés au joueur (tous ceux de la base).
static func diagnostics() -> Array:
	var d := []
	for p in LISTE:
		d.append([p["id"], p["diagnostic"]])
	return d
